# server — the app's backend, a GNAP client with its own wallet address +
# Ed25519 key (see docs/mobile-clients.md). It signs:
#   - the ownership check when the app connects a wallet (before the phone has a key)
#   - the Budget grant and its payments ("Model A: backend as client")
# The phone's own payments (Send tab) don't go through it.

# testwallet = the public Interledger Test Wallet (https://wallet.interledger-test.dev)
# local      = Rafiki's local playground (https://github.com/interledger/rafiki/tree/main/localenv)
TARGET=testwallet

# The client's own wallet address. Its `publicName` is what users see as the
# app's name on the consent screen, so give it a recognisable one.
#   testwallet: https://ilp.interledger-test.dev/<your-app-address>
#   local:      a wallet/-provisioned address, e.g. https://cloud-nine-wallet-backend/alice
CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/my-mobile-app

# Key id + private key registered on CLIENT_WALLET_ADDRESS.
#   testwallet: run `npm run gen-key` and upload the printed key in the test
#               wallet under Settings → Developer Keys (or let the test wallet
#               generate one and point these at its download + key id).
#   local:      a Cloud Nine wallet address on the playground with a key you
#               registered on it (Rafiki Admin API createWalletAddressKey)
KEY_ID=
PRIVATE_KEY_PATH=./data/keys/client.pem

# Where Rafiki's auth server sends the browser after consent. The app's URL
# scheme (app/app.json → "scheme"); ASWebAuthenticationSession / Custom
# Tabs hand this URL straight back to the app.
APP_FINISH_URI=openpayments-rn-example://op/finish

PORT=3040
DATABASE_FILE=./data/mobile.db
